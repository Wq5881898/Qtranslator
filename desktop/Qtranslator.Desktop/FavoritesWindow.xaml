<Window x:Class="Qtranslator.Desktop.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Favorites" Height="560" Width="820"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Width="110" Height="36" Click="Import_Click" Content="Import CSV"/>
                <Button Width="110" Height="36" Margin="8,0,0,0"
                        Click="Export_Click" Content="Export CSV"/>
            </StackPanel>
            <StackPanel>
                <TextBlock FontSize="23" FontWeight="SemiBold" Text="Favorites"/>
                <TextBlock x:Name="CountText" Foreground="#52635A"/>
            </StackPanel>
        </DockPanel>
        <DataGrid x:Name="FavoritesGrid" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80"/>
                <DataGridTextColumn Header="English" Binding="{Binding OriginalText}" Width="2*"/>
                <DataGridTextColumn Header="Phonetic" Binding="{Binding Phonetic}" Width="*"/>
                <DataGridTextColumn Header="Chinese" Binding="{Binding TranslatedText}" Width="2*"/>
                <DataGridTextColumn Header="First saved" Binding="{Binding FirstFavoritedAt}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Width="120" Height="36"
                    Click="Remove_Click" Content="Remove selected"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>

