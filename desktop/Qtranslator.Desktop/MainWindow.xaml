<Window x:Class="Qtranslator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Qtranslator.Desktop"
        Title="Qtranslator" Height="760" Width="860"
        MinHeight="560" MinWidth="640" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <TabControl x:Name="MainTabs" Margin="12" FontSize="14">
    <TabItem Header="翻译" Padding="20,9">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="28" FontWeight="Bold" Text="Qtranslator"/>
            <TextBlock x:Name="VersionText" Margin="0,3,0,0" Foreground="#52635A"/>
            <TextBlock x:Name="ShortcutHint" Margin="0,6,0,0" Foreground="#52635A"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,20,0,16">
            <Button x:Name="CaptureButton" Click="CaptureButton_Click"
                    Content="Select screen region"/>
            <Button x:Name="TranslateButton" Margin="10,0,0,0"
                    Click="TranslateButton_Click" Content="Translate Chinese"/>
            <Button x:Name="SettingsButton" Margin="10,0,0,0" Width="48"
                    Padding="0" FontFamily="Segoe UI Symbol" FontSize="22"
                    Click="SettingsButton_Click" Content="⚙"
                    ToolTip="Settings"/>
            <Button x:Name="FavoriteButton" Margin="10,0,0,0" Width="56"
                    Padding="0" FontSize="26" FontFamily="Segoe UI Symbol"
                    HorizontalContentAlignment="Center" Click="FavoriteButton_Click"
                    ToolTip="Save or remove current translation" Content="♡"
                    IsEnabled="False"/>
            <Button x:Name="FavoritesButton" Margin="10,0,0,0"
                    Click="FavoritesButton_Click" Content="Favorites (0)"/>
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="64" Height="30" Padding="4,0"
                        Click="CopyEnglishButton_Click" Content="Copy"/>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="English (editable)"/>
            </DockPanel>
            <TextBox x:Name="RecognizedText" Grid.Row="1" Margin="0,7,0,14"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="12" FontSize="16"/>
            <DockPanel Grid.Row="2">
                <Button x:Name="SpeakButton" DockPanel.Dock="Right" Width="92" Height="30" Padding="4,0"
                        Click="SpeakButton_Click" Content="Read aloud" IsEnabled="False"/>
                <Button DockPanel.Dock="Right" Width="64" Height="30" Padding="4,0"
                        Click="CopyChineseButton_Click" Content="Copy"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="Chinese"/>
                    <TextBlock x:Name="PhoneticText" Margin="12,0,0,0" Foreground="#52635A"
                               FontFamily="Segoe UI" FontSize="17" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
            <TextBox x:Name="TranslatedText" Grid.Row="3" Margin="0,7,0,0"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="12" FontSize="17"
                     Background="#FAFCFA"/>
        </Grid>

        <Border Grid.Row="3" Margin="0,16,0,0" Padding="12"
                Background="#F2F7F3" CornerRadius="8">
            <StackPanel>
                <DockPanel>
                    <TextBlock FontWeight="SemiBold" Text="Status"/>
                    <TextBlock x:Name="HotKeyText" DockPanel.Dock="Right"
                               Foreground="#52635A" TextAlignment="Right"/>
                </DockPanel>
                <TextBlock x:Name="StatusText" Margin="0,5,0,0" TextWrapping="Wrap"
                           Text="Starting local services..."/>
            </StackPanel>
        </Border>
    </Grid>
    </TabItem>
    <TabItem x:Name="ChatTab" Header="AI 对话" Padding="20,9">
        <local:ChatView x:Name="ChatPanel"/>
    </TabItem>
    </TabControl>
</Window>
