{
  "name": "qtranslator-extension",
  "version": "1.2.2",
  "private": true,
  "description": "A lightweight local-first English-learning translation extension.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "check": "npm run typecheck && npm test",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "verify:release": "node scripts/verify-release.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  },
  "engines": {
    "node": ">=22"
  }
}
